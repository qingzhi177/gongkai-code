<!DOCTYPE html>
<html lang="zh-CN">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Memory Dashboard</title>
    <style>
        * { margin: 0; padding: 0; box-sizing: border-box; }
        body { font-family: -apple-system, sans-serif; background: #f5f5f7; color: #333; padding: 20px; }
        .container { max-width: 1000px; margin: 0 auto; }
        h1 { text-align: center; margin: 20px 0; }
        .tabs { display: flex; gap: 6px; margin-bottom: 20px; flex-wrap: wrap; }
        .tab { padding: 8px 14px; border: none; background: #e0e0e0; border-radius: 8px; cursor: pointer; font-size: 13px; }
        .tab.active { background: #007aff; color: white; }
        .panel { display: none; background: white; border-radius: 12px; padding: 20px; }
        .panel.active { display: block; }
        .stat-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 15px; margin-bottom: 20px; }
        .stat-card { background: #f0f0f0; border-radius: 8px; padding: 15px; text-align: center; }
        .stat-card .number { font-size: 24px; font-weight: bold; color: #007aff; }
        .stat-card .label { font-size: 12px; color: #666; margin-top: 5px; }
        .btn { padding: 8px 14px; background: #007aff; color: white; border: none; border-radius: 6px; cursor: pointer; font-size: 13px; margin: 3px 2px; }
        .btn-small { padding: 4px 8px; font-size: 11px; }
        .btn-danger { background: #ff3b30; }
        .search-box { width: 100%; padding: 10px; border: 1px solid #ddd; border-radius: 8px; margin-bottom: 15px; }
        .item { border-bottom: 1px solid #eee; padding: 12px 0; }
        .item-content { font-size: 14px; margin-bottom: 5px; }
        .item-meta { font-size: 11px; color: #888; }
        .item-quote { font-size: 12px; color: #666; font-style: italic; margin: 5px 0; padding-left: 8px; border-left: 3px solid #007aff; }
        .badge { display: inline-block; padding: 2px 6px; border-radius: 4px; font-size: 10px; margin-right: 4px; }
        .badge-core { background: #ffd700; color: #333; }
        .badge-feel { background: #ff69b4; color: white; }
        .badge-type { background: #e0e0e0; }
        textarea { width: 100%; min-height: 150px; padding: 12px; border: 1px solid #ddd; border-radius: 8px; margin-bottom: 10px; font-size: 13px; }
        .section { margin-bottom: 20px; }
        .conv-item { padding: 10px; background: #f9f9f9; border-radius: 6px; margin-bottom: 8px; cursor: pointer; }
        .conv-item:hover { background: #e8e8e8; }
        .msg { padding: 8px; margin-bottom: 6px; border-radius: 6px; font-size: 13px; }
        .msg-user { background: #e3f2fd; }
        .msg-ai { background: #f1f8e9; }
        .modal-mask { display: none; position: fixed; top: 0; left: 0; right: 0; bottom: 0; background: rgba(0,0,0,0.4); z-index: 1000; align-items: center; justify-content: center; }
        .modal-mask.active { display: flex; }
        .modal-box { background: white; border-radius: 12px; padding: 20px; width: 90%; max-width: 600px; max-height: 85vh; overflow-y: auto; }
        .modal-box h3 { margin-bottom: 12px; }
        .modal-box textarea { min-height: 200px; }
        .modal-actions { text-align: right; margin-top: 6px; }
        /* Pipeline 月相样式 */
        .pipeline-stage { margin: 20px 0; text-align: center; }
        .moon-container { display: inline-block; position: relative; width: 120px; height: 120px; }
        .moon-phase {
            width: 100%;
            height: 100%;
            border-radius: 50%;
            background: radial-gradient(circle at 50% 50%, #2a2a2a 0%, #0a0a0a 100%);
            position: relative;
            overflow: hidden;
            box-shadow: 0 4px 20px rgba(0,0,0,0.5), inset 0 -2px 10px rgba(0,0,0,0.3);
        }
        .moon-light { position: absolute; top: 0; left: 0; width: 100%; height: 100%; border-radius: 50%; background: #e8e8d0; }
        .moon-percentage {
            position: absolute;
            bottom: -25px;
            left: 50%;
            transform: translateX(-50%);
            font-size: 12px;
            font-weight: bold;
            color: #666;
            white-space: nowrap;
        }
        .pipeline-label { margin-top: 35px; font-weight: bold; font-size: 14px; }
        .pipeline-detail { font-size: 12px; color: #666; margin-top: 4px; }
        /* Extraction 表格样式 */
        .extraction-table { width: 100%; border-collapse: collapse; margin-top: 15px; }
        .extraction-table th, .extraction-table td { padding: 10px; text-align: left; border-bottom: 1px solid #eee; font-size: 13px; }
        .extraction-table th { background: #f5f5f5; font-weight: bold; }
        .status-badge { padding: 3px 8px; border-radius: 12px; font-size: 11px; display: inline-block; }
        .status-extracted { background: #d4edda; color: #155724; }
        .status-pending { background: #fff3cd; color: #856404; }
        .status-partial { background: #cce5ff; color: #004085; }
        /* Narrative 样式 */
        .narrative-content { background: #fafafa; padding: 20px; border-radius: 8px; line-height: 1.8; font-size: 14px; white-space: pre-wrap; max-height: 500px; overflow-y: auto; }
        .narrative-meta { background: #f0f0f0; padding: 12px; border-radius: 6px; margin-bottom: 15px; font-size: 12px; color: #666; }
        /* Summary 样式 */
        .summary-content { background: #fafafa; padding: 15px; border-radius: 8px; line-height: 1.6; font-size: 13px; }
        .config-section { margin-bottom: 25px; padding: 15px; background: #f9f9f9; border-radius: 8px; }
        .config-section h4 { margin-bottom: 10px; font-size: 14px; }
        .config-field { margin-bottom: 10px; }
        .config-field label { display: inline-block; width: 150px; font-size: 13px; }
        .config-field select, .config-field input { padding: 6px 10px; border: 1px solid #ddd; border-radius: 4px; font-size: 13px; }
    </style>

</head>
<body>
    <div class="container">
        <h1>Memory Dashboard</h1>
        <div class="tabs">
            <button class="tab active" onclick="showPanel('overview')">总览</button>
            <button class="tab" onclick="showPanel('l0')">L0原文</button>
            <button class="tab" onclick="showPanel('l1')">L1记忆</button>
            <button class="tab" onclick="showPanel('profile')">画像</button>
            <button class="tab" onclick="showPanel('custom_prompt')">交互偏好</button>
            <button class="tab" onclick="showPanel('pipeline')">记忆管线</button>
            <button class="tab" onclick="showPanel('extraction')">记忆提取</button>
            <button class="tab" onclick="showPanel('narrative')">共同经历</button>
            <button class="tab" onclick="showPanel('summary')">近期摘要</button>
            <button class="tab" onclick="showPanel('import')">导入</button>
            <button class="tab" onclick="showPanel('config')">配置</button>
            <button class="tab" onclick="showPanel('logs')">系统日志</button>
            <button class="tab" onclick="showPanel('convs')">会话配置</button>
        </div>

        <div id="overview" class="panel active">
            <div class="stat-grid">
                <div class="stat-card"><div class="number" id="stat-l0">-</div><div class="label">L0消息</div></div>
                <div class="stat-card"><div class="number" id="stat-l1">-</div><div class="label">L1记忆</div></div>
                <div class="stat-card"><div class="number" id="stat-conv">-</div><div class="label">对话数</div></div>
                <div class="stat-card"><div class="number" id="stat-core">-</div><div class="label">核心记忆</div></div>
                <div class="stat-card"><div class="number" id="stat-status">-</div><div class="label">状态</div></div>
            </div>
            <h3>记忆类型分布</h3>
            <div id="type-stats" style="margin:10px 0;"></div>
            <h3>来源分布</h3>
            <div id="client-stats" style="margin:10px 0;"></div>
            <button class="btn" onclick="loadStats()">刷新</button>
        </div>

        <div id="l0" class="panel">
            <h3>对话列表</h3>
            <div id="conv-list"></div>
            <h3 style="margin-top:15px;">消息内容</h3>
            <div id="l0-messages"></div>
        </div>

        <div id="l1" class="panel">
            <div style="margin-bottom:15px;">
                <button class="btn" onclick="loadL1('all')">全部</button>
                <button class="btn" onclick="loadL1('preference_change')">偏好</button>
                <button class="btn" onclick="loadL1('fact')">事实</button>
                <button class="btn" onclick="loadL1('event')">事件</button>
                <button class="btn" onclick="loadL1('feel')">感受</button>
                <button class="btn" onclick="loadFeel('ai_self')">感受·AI自述</button>
                <button class="btn" onclick="loadFeel('conv')">感受·对话提取</button>
                <button class="btn" onclick="loadL1('relationship')">关系</button>
                <button class="btn" onclick="loadL1('core')">仅核心</button>
            </div>
            <input type="text" class="search-box" id="l1-search" placeholder="搜索L1记忆...">
            <button class="btn" onclick="searchL1()">搜索</button>
            <div id="l1-list" style="margin-top:15px;"></div>
        </div>

        <div id="profile" class="panel">
            <div class="section"><h3>关于用户</h3><textarea id="profile-user"></textarea></div>
            <div class="section"><h3>关于AI</h3><textarea id="profile-ai"></textarea></div>
            <div class="section"><h3>关于我们</h3><textarea id="profile-us"></textarea></div>
            <button class="btn" onclick="saveProfile()">保存</button>
            <span id="profile-status"></span>
        </div>

        <div id="custom_prompt" class="panel">
            <h3>用户交互偏好</h3>
            <p style="color:#666;font-size:12px;margin-bottom:15px;">
                自定义你希望 AI 在对话中遵循的交互风格、回复方式或其他偏好。这些内容会作为系统提示的一部分注入到每次对话中。
            </p>
            <div class="config-field">
                <label>
                    <input type="checkbox" id="custom-prompt-enabled" checked> 启用交互偏好
                </label>
            </div>
            <textarea id="custom-prompt-content" placeholder="例如：回复时尽量简洁，不要过度解释；遇到代码问题时先提供解决方案再解释原理；等等..."></textarea>
            <button class="btn" onclick="saveCustomPrompt()">保存</button>
            <span id="custom-prompt-status"></span>
        </div>

        <div id="import" class="panel">
            <h3>导入历史对话</h3>
            <div style="margin-bottom:15px;">
                <button class="btn" onclick="document.getElementById('file-input').click()">选择文件</button>
                <input type="file" id="file-input" accept=".json,.txt" style="display:none" onchange="handleFile(event)">
                <span id="file-name" style="margin-left:10px;color:#666;"></span>
            </div>
            <select id="import-client" style="margin-bottom:10px;">
                <option value="kelivo">Kelivo</option>
                <option value="other">其他</option>
            </select>
            <textarea id="import-text" placeholder="或粘贴JSON"></textarea>
            <button class="btn" onclick="doImport()">导入</button>
            <div id="import-status" style="margin-top:10px;"></div>
        </div>

        <div id="config" class="panel">
            <h3>当前使用</h3>
            <div id="config-active" style="margin-bottom:8px;color:#666;">-</div>
            <div style="margin-bottom:20px;">
                <select id="config-active-provider" style="margin-right:8px;" onchange="onActiveProviderChange()"></select>
                <select id="config-active-model" style="margin-right:8px;"></select>
                <button class="btn" onclick="setActive()">应用并热重载</button>
                <span id="config-active-status" style="margin-left:8px;"></span>
            </div>

            <h3>供应商列表</h3>
            <div id="config-provider-list" style="margin-bottom:20px;"></div>

            <h3 id="config-form-title">添加供应商</h3>
            <input type="hidden" id="config-edit-id" value="">
            <div class="section">
                <input type="text" id="config-name" placeholder="名称（如：中转站A）" style="width:100%;margin-bottom:8px;">
                <input type="text" id="config-baseurl" placeholder="Base URL（如：https://xxx.com/v1）" style="width:100%;margin-bottom:8px;">
                <input type="password" id="config-apikey" placeholder="API Key（编辑时留空则不修改）" style="width:100%;margin-bottom:8px;" autocomplete="new-password">
                <input type="text" id="config-models" placeholder="模型列表，逗号分隔（如：claude-opus-4-6,claude-sonnet-4-5）" style="width:100%;margin-bottom:8px;">
                <button class="btn" onclick="saveProvider()">保存</button>
                <button class="btn" onclick="resetProviderForm()" style="background:#999;">清空</button>
                <span id="config-form-status" style="margin-left:8px;"></span>
            </div>

            <h3 style="margin-top:30px;">模块模型配置</h3>
            <div id="model-configs" style="margin-top:15px;"></div>
        </div>

        <!-- Pipeline 页面 -->
        <div id="pipeline" class="panel">
            <h3 style="text-align:center;margin-bottom:30px;">记忆管线状态</h3>
            <div style="display:flex;justify-content:space-around;flex-wrap:wrap;">
                <div class="pipeline-stage">
                    <div class="moon-container">
                        <canvas id="moon-l0" width="120" height="120"></canvas>
                    </div>
                    <div class="pipeline-label">L0 对话原文</div>
                    <div class="pipeline-detail" id="pipeline-l0-detail">-</div>
                </div>
                <div class="pipeline-stage">
                    <div class="moon-container">
                        <canvas id="moon-l1" width="120" height="120"></canvas>
                    </div>
                    <div class="pipeline-label">L1 记忆提取</div>
                    <div class="pipeline-detail" id="pipeline-l1-detail">-</div>
                </div>
                <div class="pipeline-stage">
                    <div class="moon-container">
                        <canvas id="moon-embedding" width="120" height="120"></canvas>
                    </div>
                    <div class="pipeline-label">向量嵌入</div>
                    <div class="pipeline-detail" id="pipeline-embedding-detail">-</div>
                </div>
                <div class="pipeline-stage">
                    <div class="moon-container">
                        <canvas id="moon-narrative" width="120" height="120"></canvas>
                    </div>
                    <div class="pipeline-label">共同经历叙事</div>
                    <div class="pipeline-detail" id="pipeline-narrative-detail">-</div>
                </div>
            </div>
            <div style="text-align:center;margin-top:30px;">
                <button class="btn" onclick="loadPipeline()">刷新状态</button>
            </div>
        </div>

        <!-- Extraction 页面 -->
        <div id="extraction" class="panel">
            <h3>L1 提取状态</h3>
            <div class="stat-grid" style="margin-top:15px;">
                <div class="stat-card"><div class="number" id="extract-total">-</div><div class="label">总消息数</div></div>
                <div class="stat-card"><div class="number" id="extract-done">-</div><div class="label">已提取</div></div>
                <div class="stat-card"><div class="number" id="extract-pending">-</div><div class="label">待提取</div></div>
            </div>
            <div style="margin:20px 0;">
                <button class="btn" onclick="triggerExtract()">立即提取</button>
                <span id="extract-status" style="margin-left:10px;font-size:12px;"></span>
            </div>
            <h3>批次列表</h3>
            <table class="extraction-table">
                <thead>
                    <tr>
                        <th>日期</th>
                        <th>消息范围</th>
                        <th>总数</th>
                        <th>已提取</th>
                        <th>状态</th>
                    </tr>
                </thead>
                <tbody id="extraction-batches"></tbody>
            </table>
        </div>

        <!-- Narrative 页面 -->
        <div id="narrative" class="panel">
            <h3>共同经历叙事</h3>
            <div class="narrative-meta" id="narrative-meta">
                暂无叙事
            </div>
            <div style="margin-bottom:15px;">
                <button class="btn" onclick="generateNarrative()">生成/更新叙事</button>
                <button class="btn" onclick="editNarrative()" style="background:#28a745;">编辑</button>
                <button class="btn" onclick="loadNarrativeHistory()" style="background:#6c757d;">查看历史</button>
                <button class="btn" onclick="showNarrativeTimeline()" style="background:#6f42c1;">时间线</button>
                <button class="btn" onclick="toggleNarrativeObservatory()" style="background:#17a2b8;">Observatory</button>
                <span id="narrative-status" style="margin-left:10px;font-size:12px;"></span>
            </div>
            <div id="narrative-observatory" style="display:none;margin-bottom:15px;padding:12px;background:#f8f9fa;border-radius:6px;font-size:13px;">
                <div style="margin-bottom:8px;"><strong>更新原因：</strong><span id="observatory-reason">-</span></div>
                <div style="margin-bottom:8px;"><strong>演化模式：</strong><span id="observatory-mode">-</span></div>
                <div style="margin-bottom:8px;"><strong>消费记忆数：</strong><span id="observatory-l1-count">-</span></div>
                <div><strong>来源记忆 ID：</strong><span id="observatory-l1-ids" style="font-family:monospace;font-size:12px;">-</span></div>
            </div>
            <div class="narrative-content" id="narrative-content">
                暂无内容
            </div>
        </div>

        <!-- Summary 页面 -->
        <div id="summary" class="panel">
            <h3>近期摘要</h3>
            <div style="margin:15px 0;">
                <button class="btn" onclick="generateSummary()">生成摘要</button>
                <button class="btn" onclick="editSummary()" style="background:#28a745;">编辑</button>
                <button class="btn" onclick="toggleSummaryObservatory()" style="background:#17a2b8;">Observatory</button>
                <span id="summary-status" style="margin-left:10px;font-size:12px;"></span>
            </div>
            <div id="summary-observatory" style="display:none;margin-bottom:15px;padding:12px;background:#f8f9fa;border-radius:6px;font-size:13px;">
                <div style="margin-bottom:8px;"><strong>自动更新：</strong><span id="observatory-auto-status">-</span></div>
                <div style="margin-bottom:8px;"><strong>下次更新预计：</strong><span id="observatory-next-update">-</span></div>
                <div><strong>阈值进度：</strong><span id="observatory-threshold-progress">-</span></div>
            </div>
            <div class="summary-content" id="summary-content" style="margin-bottom:20px;">
                暂无摘要
            </div>

            <h3 style="margin-top:30px;">自动更新检查策略</h3>
            <div class="config-section">
                <div class="config-field">
                    <label>自动更新：</label>
                    <select id="summary-auto-enabled">
                        <option value="1">启用</option>
                        <option value="0">禁用</option>
                    </select>
                </div>
                <div class="config-field">
                    <label>检查阈值（轮数）：</label>
                    <input type="number" id="summary-threshold-turns" style="width:100px;" value="50">
                </div>
                <div class="config-field">
                    <label>检查阈值（L1数）：</label>
                    <input type="number" id="summary-threshold-l1" style="width:100px;" value="10">
                </div>
                <div class="config-field">
                    <label>最大轮数：</label>
                    <input type="number" id="summary-max-turns" style="width:100px;" value="100">
                </div>
                <div class="config-field">
                    <label>最大Token：</label>
                    <input type="number" id="summary-max-tokens" style="width:100px;" value="50000">
                </div>
                <button class="btn" onclick="saveSummaryConfig()">保存配置</button>
                <span id="summary-config-status" style="margin-left:10px;font-size:12px;"></span>
            </div>

            <!-- 危险操作区域 -->
            <div style="margin-top:40px;padding:20px;background:#fff3cd;border:2px solid #ffc107;border-radius:8px;">
                <h4 style="color:#856404;margin-top:0;">⚠️ 危险操作</h4>
                <p style="font-size:13px;color:#856404;margin-bottom:15px;">
                    以下操作不可逆，将永久删除所有数据（L0原文、L1记忆、向量库、Narrative、Summary、Profile）。<br>
                    清空后需要重新导入对话数据。
                </p>
                <button class="btn" onclick="confirmPurgeAll()" style="background:#dc3545;color:white;font-weight:bold;">
                    🗑️ 清空所有数据
                </button>
                <span id="purge-status" style="margin-left:10px;font-size:12px;"></span>
            </div>
        </div>

        <!-- System Logs 页面 -->
        <div id="convs" class="panel">
            <h3>会话配置（TG/Kelivo 同步的窗口与推理强度）</h3>
            <div class="config-section">
                <h4>选择会话</h4>
                <select id="convs-select" style="width:100%;margin-bottom:8px;" onchange="onConvSelect()"></select>
                <div style="font-size:12px;color:#888;" id="convs-meta"></div>
            </div>
            <div class="config-section">
                <h4>会话设置</h4>
                <div style="margin-bottom:8px;"><label>窗口模式：</label>
                    <select id="convs-window-mode" style="margin-right:8px;">
                        <option value="all">全部（最新500条）</option>
                        <option value="n">按条数</option>
                        <option value="tokens">按token预算</option>
                    </select>
                </div>
                <div style="margin-bottom:8px;"><label>条数：</label>
                    <input type="number" id="convs-window-n" style="width:100px;" min="1" value="50"></div>
                <div style="margin-bottom:8px;"><label>Token预算：</label>
                    <input type="number" id="convs-window-tokens" style="width:100px;" min="100" value="8000"></div>
                <div style="margin-bottom:8px;"><label>推理强度(effort)：</label>
                    <select id="convs-effort" style="margin-right:8px;">
                        <option value="low">low</option>
                        <option value="medium">medium</option>
                        <option value="high">high</option>
                    </select>
                </div>
                <div style="margin-bottom:8px;"><label>模型（留空=网关默认）：</label>
                    <input type="text" id="convs-model" placeholder="如 claude-opus-4-6" style="width:60%;"></div>
                <button onclick="saveConvSettings()" style="padding:6px 16px;background:#4f46e5;color:#fff;border:none;border-radius:4px;cursor:pointer;">保存</button>
                <span id="convs-status" style="margin-left:10px;font-size:12px;"></span>
            </div>
        </div>
        <div id="logs" class="panel">
            <h3>系统日志</h3>
            <div style="margin-bottom:15px;">
                <button class="btn" onclick="loadLogs()">刷新日志</button>
                <button class="btn" onclick="testAutoCheck()" style="background:#17a2b8;">手动触发检查</button>
                <span id="logs-status" style="margin-left:10px;font-size:12px;"></span>
            </div>
            <div id="logs-content" style="background:#f8f9fa;padding:12px;border-radius:6px;font-family:monospace;font-size:12px;line-height:1.6;max-height:600px;overflow-y:auto;white-space:pre-wrap;word-break:break-all;">
                暂无日志
            </div>
        </div>
    </div>

    <!-- 修复4：L1 内容编辑弹窗 -->
    <div id="editModal" class="modal-mask">
        <div class="modal-box">
            <h3>编辑记忆内容</h3>
            <input type="hidden" id="edit-l1-id" value="">
            <textarea id="edit-l1-content" placeholder="记忆内容"></textarea>
            <div style="font-size:11px;color:#888;margin-bottom:8px;">保存后会重新生成向量，recall 检索将命中新内容。</div>
            <div class="modal-actions">
                <button class="btn" style="background:#999;" onclick="closeEditL1()">取消</button>
                <button class="btn" onclick="saveEditL1()">保存</button>
                <span id="edit-l1-status" style="margin-left:8px;font-size:12px;"></span>
            </div>
        </div>
    </div>

    <div id="editNarrativeModal" class="modal-mask">
        <div class="modal-box" style="width:90%;max-width:900px;">
            <h3>编辑共同经历叙事</h3>
            <textarea id="edit-narrative-content" placeholder="叙事内容" style="min-height:400px;font-family:inherit;line-height:1.6;"></textarea>
            <div style="font-size:11px;color:#888;margin-bottom:8px;">直接编辑当前版本，保存后将创建新版本（旧版本保留为 superseded）。</div>
            <div class="modal-actions">
                <button class="btn" style="background:#999;" onclick="closeEditNarrative()">取消</button>
                <button class="btn" onclick="saveEditNarrative()">保存</button>
                <span id="edit-narrative-status" style="margin-left:8px;font-size:12px;"></span>
            </div>
        </div>
    </div>

    <div id="editSummaryModal" class="modal-mask">
        <div class="modal-box" style="width:80%;max-width:700px;">
            <h3>编辑近期摘要</h3>
            <textarea id="edit-summary-content" placeholder="摘要内容" style="min-height:300px;font-family:inherit;line-height:1.6;"></textarea>
            <div style="font-size:11px;color:#888;margin-bottom:8px;">直接编辑当前摘要，保存后即时生效。</div>
            <div class="modal-actions">
                <button class="btn" style="background:#999;" onclick="closeEditSummary()">取消</button>
                <button class="btn" onclick="saveEditSummary()">保存</button>
                <span id="edit-summary-status" style="margin-left:8px;font-size:12px;"></span>
            </div>
        </div>
    </div>

    <script>
        var API = '/api';
        var currentConv = null;
        var currentPage = 0;
        var pageSize = 100;

        function formatTime(ts) {
            if (!ts) return '';
            try {
                var str = ts.replace(' ', 'T');
                if (str.indexOf('Z') === -1 && str.indexOf('+') === -1) str += 'Z';
                var d = new Date(str);
                var y = d.getFullYear();
                var mo = String(d.getMonth() + 1).padStart(2, '0');
                var day = String(d.getDate()).padStart(2, '0');
                var h = String(d.getHours()).padStart(2, '0');
                var mi = String(d.getMinutes()).padStart(2, '0');
                return y + '-' + mo + '-' + day + ' ' + h + ':' + mi;
            } catch(e) { return ts.substring(0, 16); }
        }

        function showPanel(name) {
            document.querySelectorAll('.panel').forEach(function(p) { p.classList.remove('active'); });
            document.querySelectorAll('.tab').forEach(function(t) { t.classList.remove('active'); });
            document.getElementById(name).classList.add('active');
            event.target.classList.add('active');
            if (name === 'overview') loadStats();
            if (name === 'l0') loadConversations();
            if (name === 'l1') loadL1('all');
            if (name === 'profile') loadProfile();
            if (name === 'custom_prompt') loadCustomPrompt();
            if (name === 'config') loadConfig();
            if (name === 'convs') loadConvs();
            if (name === 'logs') loadLogs();
            if (name === 'pipeline') loadPipeline();
            if (name === 'extraction') loadExtraction();
            if (name === 'narrative') loadNarrative();
            if (name === 'summary') loadSummary();
        }

        function loadStats() {
            fetch(API + '/stats').then(function(r) { return r.json(); }).then(function(d) {
                document.getElementById('stat-l0').textContent = d.l0_messages;
                document.getElementById('stat-l1').textContent = d.l1_memories;
                document.getElementById('stat-status').textContent = 'OK';
            });
            fetch(API + '/stats/detail').then(function(r) { return r.json(); }).then(function(d) {
                document.getElementById('stat-conv').textContent = d.conv_count || 0;
                document.getElementById('stat-core').textContent = d.core_count || 0;
                var typeHtml = '';
                var types = d.type_stats || {};
                Object.keys(types).forEach(function(k) {
                    typeHtml += '<span style="display:inline-block;margin:3px 6px;padding:4px 10px;background:#e8e8e8;border-radius:12px;font-size:12px;">' + k + ': ' + types[k] + '</span>';
                });
                document.getElementById('type-stats').innerHTML = typeHtml || '<span style="color:#888;">暂无数据</span>';
                var clientHtml = '';
                var clients = d.client_stats || {};
                Object.keys(clients).forEach(function(k) {
                    clientHtml += '<span style="display:inline-block;margin:3px 6px;padding:4px 10px;background:#d4eda;border-radius:12px;font-size:12px;">' + k + ': ' + clients[k] + '</span>';
                });
                document.getElementById('client-stats').innerHTML = clientHtml || '<span style="color:#888;">暂无数据</span>';
            });
        }

        function loadConversations() {
            fetch(API + '/l0/conversations?limit=500').then(function(r) { return r.json(); }).then(function(d) {
                var html = '';
                (d.conversations || []).forEach(function(c) {
                    html += '<div class="conv-item" onclick="loadL0Messages(\'' + c.conv_id + '\')">';
                    html += '<strong>' + c.conv_id + '</strong> (' + c.client + ')<br>';
                    html += '<span style="font-size:11px;color:#666;">' + c.msg_count + ' 条 | ' + formatTime(c.last_ts) + '</span>';
                    html += '<br><button class="btn btn-small btn-danger" onclick="event.stopPropagation();deleteConv(\'' + c.conv_id + '\')">删除对话</button>';                    
                    html += '</div>';
                });
                document.getElementById('conv-list').innerHTML = html || '<p>暂无对话</p>';
            });
        }

        function loadL0Messages(convId) {
            currentConv = convId;
            currentPage = 0;
            renderL0Page();
        }

        function renderL0Page() {
            fetch(API + '/l0/messages?conv_id=' + currentConv).then(function(r) { return r.json(); }).then(function(d) {
                var messages = d.messages || [];
                var start = currentPage * pageSize;
                var end = start + pageSize;
                var page = messages.slice(start, end);
                var html = '<div style="margin-bottom:10px;"><span>共 ' + messages.length + ' 条，显示 ' + (start+1) + '-' + Math.min(end, messages.length) + '</span>';
                if (currentPage > 0) html += ' <button class="btn btn-small" onclick="currentPage--;renderL0Page()">上一页</button>';
                if (end < messages.length) html += ' <button class="btn btn-small" onclick="currentPage++;renderL0Page()">下一页</button>';
                html += '</div>';
                page.forEach(function(m) {
                    var cls = m.role === 'user' ? 'msg-user' : 'msg-ai';
                    var prefix = m.role === 'user' ? '👤' : '🤖';
                html += '<div class="msg ' + cls + '"><span style="font-size:10px;color:#999;cursor:pointer;text-decoration:underline;" onclick="editTimestamp(' + m.id + ',\'' + (m.ts || '') + '\')">' + formatTime(m.ts) + '</span> <span style="font-size:10px;color:#ff3b30;cursor:pointer;" onclick="deleteMsg(' + m.id + ')">删除</span><br>' + prefix + ' ' + m.content + '</div>';
                });
                document.getElementById('l0-messages').innerHTML = html || '<p>无消息</p>';
            });
        }

        function loadL1(type) {
            var url = API + '/l1/list?limit=1000';
            if (type !== 'all' && type !== 'core') url += '&event_type=' + type;
            fetch(url).then(function(r) { return r.json(); }).then(function(d) {
                var memories = d.memories || [];
                if (type === 'core') memories = memories.filter(function(m) { return m.is_core; });
                renderL1(memories);
            });
        }

        // 修复2：feel 来源区分。拉全部 feel 后按 client 过滤：
        // client='ai_self' 是 AI 主动调 feel 记录的；其他（对话提取）是从 L0 提取出来的。
        function loadFeel(source) {
            fetch(API + '/l1/list?limit=1000&event_type=feel').then(function(r) { return r.json(); }).then(function(d) {
                var memories = d.memories || [];
                if (source === 'ai_self') {
                    memories = memories.filter(function(m) { return m.client === 'ai_self'; });
                } else {
                    memories = memories.filter(function(m) { return m.client !== 'ai_self'; });
                }
                renderL1(memories);
            });
        }

        function searchL1() {
            var q = document.getElementById('l1-search').value;
            if (!q) return;
            fetch(API + '/search', {
                method: 'POST',
                headers: {'Content-Type': 'application/json'},
                body: JSON.stringify({query: q, mode: 'semantic', n: 20})
            }).then(function(r) { return r.json(); }).then(function(d) {
                var memories = (d.memories || []).map(function(m) {
                var meta = m.metadata || {};
                    return { id: parseInt(m.id.replace('l1_','')), content: m.l1_summary || '', quote: m.quote || meta.quote || '', event_type: meta.event_type || '', tags: meta.tags || '', valence: meta.valence, arousal: meta.arousal, is_core: meta.is_core || 0, access_count: 0, ts: meta.ts || '', client: meta.client || '' };
                });
                renderL1(memories);
            });
        }

        var l1Cache = {};

        function renderL1(memories) {
            l1Cache = {};
            var html = '<p style="color:#666;margin-bottom:10px;">共 ' + memories.length + ' 条</p>';
            memories.forEach(function(m) {
                l1Cache[m.id] = m.content;
                html += '<div class="item">';
                html += '<div class="item-content">';
                if (m.is_core) html += '<span class="badge badge-core">核心</span>';
                if (m.event_type === 'feel') html += '<span class="badge badge-feel">感受</span>';
                else if (m.event_type) html += '<span class="badge badge-type">' + m.event_type + '</span>';
                html += m.content + '</div>';
                if (m.quote && m.quote !== m.content) html += '<div class="item-quote">"' + m.quote + '"</div>';
                if (m.tags) html += '<div style="font-size:11px;color:#007aff;margin:3px 0;">标签: ' + m.tags + '</div>';
                html += '<div class="item-meta">' + formatTime(m.ts) + ' | ' + (m.client || 'AI') + ' |翻阅' + (m.access_count||0) + '次';
                if (m.valence != null) html += ' | v' + m.valence + '/a' + (m.arousal||0);
                html += '</div>';
                html += '<div style="margin-top:6px;">';
                html += '<button class="btn btn-small" onclick="editL1Content(' + m.id + ')">编辑内容</button> ';
                html += '<button class="btn btn-small" onclick="toggleCore(' + m.id + ',' + (m.is_core||0) + ')">' + (m.is_core ? '取消核心' : '标记核心') + '</button> ';
                html += '<button class="btn btn-small" onclick="editTags(' + m.id + ')">编辑标签</button> ';
                html += '<button class="btn btn-small" onclick="changeType(' + m.id + ')">改类型</button> ';
                // 重构：有 L0 关联（has_source）才可重提取；ai_self 感受无关联，不显示
                if (m.has_source) html += '<button class="btn btn-small" style="background:#34c759;" onclick="reextractL1(' + m.id + ')">重提取</button> ';
                html += '<button class="btn btn-small btn-danger" onclick="deleteL1(' + m.id + ')">删除</button>';
                html += '</div>';
                html += '</div>';  // 闭合 item
            });
            document.getElementById('l1-list').innerHTML = html || '<p>暂无记忆</p>';
        }

        // 修复4：L1 内容编辑
        function editL1Content(id) {
            document.getElementById('edit-l1-id').value = id;
            document.getElementById('edit-l1-content').value = l1Cache[id] || '';
            document.getElementById('edit-l1-status').textContent = '';
            document.getElementById('editModal').classList.add('active');
            document.getElementById('edit-l1-content').focus();
        }

        function closeEditL1() {
            document.getElementById('editModal').classList.remove('active');
        }

        function saveEditL1() {
            var id = document.getElementById('edit-l1-id').value;
            var content = document.getElementById('edit-l1-content').value.trim();
            var statusEl = document.getElementById('edit-l1-status');
            if (!content) { statusEl.textContent = '内容不能为空'; return; }
            statusEl.textContent = '保存中，正在重建向量...';
            fetch(API + '/l1/' + id, {
                method: 'PUT',
                headers: {'Content-Type': 'application/json'},
                body: JSON.stringify({content: content})
            }).then(function(r) { return r.json(); }).then(function(d) {
                if (d.warning) { statusEl.textContent = '⚠ ' + d.warning; return; }
                statusEl.textContent = '已保存';
                closeEditL1();
                loadL1('all');
            }).catch(function(e) { statusEl.textContent = '保存失败: ' + e; });
        }

        function toggleCore(id, cur) {
            fetch(API + '/l1/' + id, { method: 'PUT', headers: {'Content-Type': 'application/json'}, body: JSON.stringify({is_core: cur ? 0 : 1}) }).then(function() { loadL1('all'); });
        }

        function editTags(id) {
            var t = prompt('输入标签（逗号分隔）：');
            if (t === null) return;
            var arr = t.split(',').map(function(s){return s.trim();}).filter(function(s){return s;});
            fetch(API + '/l1/' + id, { method: 'PUT', headers: {'Content-Type': 'application/json'}, body: JSON.stringify({tags: JSON.stringify(arr)}) }).then(function() { loadL1('all'); });
        }

        function changeType(id) {
            var types = ['preference_change','fact','event','plan','relationship','feel','general'];
            var c = prompt('选择类型：\n' + types.map(function(t,i){return (i+1)+'.'+t;}).join('\n') + '\n\n输入数字：');
            if (!c) return;
            var idx = parseInt(c) - 1;
            if (idx >= 0 && idx < types.length) {
                fetch(API + '/l1/' + id, { method: 'PUT', headers: {'Content-Type': 'application/json'}, body: JSON.stringify({event_type: types[idx]}) }).then(function() { loadL1('all'); });
            }
        }

        function deleteL1(id) {
            if (!confirm('确定删除？')) return;
            fetch(API + '/l1/' + id, { method: 'DELETE' }).then(function() { loadL1('all'); });
        }

        // 重构：单条重提取。基于关联 L0 原文重新提炼 → 生成新 L1 → 硬删旧 L1。
        function reextractL1(id) {
            if (!confirm('基于原文重新提取这条记忆？旧记忆会被替换。')) return;
            fetch(API + '/l1/' + id + '/reextract', { method: 'POST' })
                .then(function(r) { return r.json().then(function(d){ return {ok: r.ok, d: d}; }); })
                .then(function(res) {
                    if (!res.ok || res.d.status === 'error') {
                        alert('重提取失败：' + (res.d.detail || '未知错误'));
                        return;
                    }
                    if (res.d.warning) alert('已重提取（有警告）：' + res.d.warning);
                    loadL1('all');
                })
                .catch(function(e) { alert('重提取失败：' + e); });
        }

        function loadProfile() {
            fetch(API + '/profile').then(function(r) { return r.json(); }).then(function(d) {
                document.getElementById('profile-user').value = d.about_user || '';
                document.getElementById('profile-ai').value = d.about_ai || '';
                document.getElementById('profile-us').value = d.about_us || '';
            });
        }

        function saveProfile() {
            fetch(API + '/profile', { method: 'POST', headers: {'Content-Type': 'application/json'}, body: JSON.stringify({ about_user: document.getElementById('profile-user').value, about_ai: document.getElementById('profile-ai').value, about_us: document.getElementById('profile-us').value }) }).then(function() { document.getElementById('profile-status').textContent = '已保存'; setTimeout(function(){document.getElementById('profile-status').textContent='';},2000); });
        }

        function saveCustomPrompt() {
            var content = document.getElementById('custom-prompt-content').value;
            var enabled = document.getElementById('custom-prompt-enabled').checked ? 1 : 0;
            fetch(API + '/custom_prompt', {
                method: 'PUT',
                headers: {'Content-Type': 'application/json'},
                body: JSON.stringify({ content: content, enabled: enabled })
            }).then(function() {
                document.getElementById('custom-prompt-status').textContent = '已保存';
                setTimeout(function(){document.getElementById('custom-prompt-status').textContent='';},2000);
            });
        }

        function loadCustomPrompt() {
            fetch(API + '/custom_prompt').then(function(r) { return r.json(); }).then(function(data) {
                document.getElementById('custom-prompt-content').value = data.content || '';
                document.getElementById('custom-prompt-enabled').checked = data.enabled === 1;
            });
        }

        function handleFile(event) {
            var file = event.target.files[0];
            if (!file) return;
            document.getElementById('file-name').textContent = file.name;
            var reader = new FileReader();
            reader.onload = function(e) { document.getElementById('import-text').value = e.target.result; };
            reader.readAsText(file);
        }

        function doImport() {
            var text = document.getElementById('import-text').value.trim();
            if (!text) return;
            var data = JSON.parse(text);
            var messages = [];
            var client = document.getElementById('import-client').value;
            if (Array.isArray(data)) {
                messages = data;
            } else if (data.messages && data.conversations) {
                var conv = data.conversations[0];
                var vs = (conv && conv.versionSelections) || {};
                var msgMap = {};
                var groupMap = {};
                data.messages.forEach(function(m) {
                    msgMap[m.id] = m;
                    var gid = m.groupId || m.id;
                    if (!groupMap[gid]) groupMap[gid] = [];
                    groupMap[gid].push(m);
                });
                var seen = {};
                var mids = conv ? conv.messageIds : data.messages.map(function(m){return m.id;});
                mids.forEach(function(mid) {
                    var msg = msgMap[mid];
                    if (!msg) return;
                var gid = msg.groupId || msg.id;
                if (seen[gid]) return;
                    seen[gid] = true;
                    var versions = groupMap[gid] || [msg];
                    var chosen = msg;
                    if (vs[gid] !== undefined) {
                        for (var i = 0; i < versions.length; i++) {
                            if (versions[i].version === vs[gid]) { chosen = versions[i]; break; }
                        }
                    }if (chosen.content) {
                        messages.push({role: chosen.role, content: chosen.content, timestamp: chosen.timestamp || ''});
                    }
                });

            } else if (data.messages) {
                messages = data.messages;
            }
            if (messages.length === 0) {
                document.getElementById('import-status').textContent = '未解析到消息';
                return;
            }
            document.getElementById('import-status').textContent = '解析到 ' + messages.length + ' 条，正在导入...';
            fetch(API + '/import_conversation', {
                method: 'POST',
                headers: {'Content-Type': 'application/json'},
                body: JSON.stringify({client: client, messages: messages})
            }).then(function(r) { return r.json(); }).then(function(d) {
                document.getElementById('import-status').textContent = d.status === 'ok' ? '导入成功！保存' + d.saved + '条' : '失败';
                if (d.status === 'ok') document.getElementById('import-text').value = '';
            });
        }

        function editTimestamp(id, currentTs) {
            var newTs = prompt('修改时间（格式：2026-07-05 01:25:00）：', currentTs);
            if (!newTs) return;
            fetch(API + '/l0/' + id + '/timestamp', {
                method: 'PUT',
                headers: {'Content-Type': 'application/json'},
                body: JSON.stringify({ts: newTs})
            }).then(function() { renderL0Page(); });
        }

        function deleteMsg(id) {
            if (!confirm('确定删除这条消息？')) return;
            fetch(API + '/l0/message/' + id, { method: 'DELETE' }).then(function() { renderL0Page(); });
        }

        function deleteConv(convId) {
            if (!confirm('确定删除整个对话？（所有消息都会被删除）')) return;
            fetch(API + '/l0/conversation/' + convId, { method: 'DELETE' }).then(function() { loadConversations(); document.getElementById('l0-messages').innerHTML = ''; });
        }

        // ============ 功能6：模型配置 ============
        var configProviders = [];   // 缓存供应商列表
        var configActive = null;    // { provider_id, model }

        // 供应商下拉变化时，刷新该供应商的模型下拉
        function onActiveProviderChange() {
            var pid = parseInt(document.getElementById('config-active-provider').value, 10);
            var modelSel = document.getElementById('config-active-model');
            var p = configProviders.filter(function(x){ return x.id === pid; })[0];
            if (!p) { modelSel.innerHTML = '<option value="">—</option>'; return; }
            var html = '';
            (p.models || []).forEach(function(m) {
                var sel = (configActive && configActive.model === m) ? ' selected' : '';
                html += '<option value="' + escapeHtml(m) + '"' + sel + '>' + escapeHtml(m) + '</option>';
            });
            modelSel.innerHTML = html || '<option value="">（该供应商无模型）</option>';
        }

        function setActive() {
            var pid = parseInt(document.getElementById('config-active-provider').value, 10);
            var model = document.getElementById('config-active-model').value;
            var status = document.getElementById('config-active-status');
            if (!pid || !model) { status.textContent = '请选择供应商和模型'; status.style.color = '#e74c3c'; return; }
            status.textContent = '应用中...'; status.style.color = '#666';
            fetch(API + '/config/active', {
                method: 'POST', headers: {'Content-Type': 'application/json'},
                body: JSON.stringify({ provider_id: pid, model: model })
            }).then(function(r) { return r.json(); }).then(function(d) {
                if (d.status === 'ok') {
                    // 记忆服务保存后会自动通知网关热重载
                    var reloaded = d.gateway_reloaded ? '，网关已热重载' : '（网关重载未确认，可稍后重试）';
                    status.textContent = '已应用' + reloaded; status.style.color = '#27ae60';
                    loadConfig();
                } else {
                    status.textContent = '失败：' + (d.message || '未知错误'); status.style.color = '#e74c3c';
                }
            }).catch(function(e) { status.textContent = '请求失败：' + e.message; status.style.color = '#e74c3c'; });
        }

        function saveProvider() {
            var id = document.getElementById('config-edit-id').value;
            var name = document.getElementById('config-name').value.trim();
            var baseUrl = document.getElementById('config-baseurl').value.trim();
            var apiKey = document.getElementById('config-apikey').value;
            var modelsRaw = document.getElementById('config-models').value.trim();
            var status = document.getElementById('config-form-status');
            if (!name || !baseUrl) { status.textContent = '名称和 Base URL 必填'; status.style.color = '#e74c3c'; return; }
            var models = modelsRaw ? modelsRaw.split(',').map(function(s){ return s.trim(); }).filter(Boolean) : [];
            var body = { name: name, base_url: baseUrl, models: models };
            // api_key 留空时不传，后端保留原 key（编辑场景）
            if (apiKey) body.api_key = apiKey;
            var url = id ? (API + '/config/providers/' + id) : (API + '/config/providers');
            var method = id ? 'PUT' : 'POST';
            status.textContent = '保存中...'; status.style.color = '#666';
            fetch(url, { method: method, headers: {'Content-Type': 'application/json'}, body: JSON.stringify(body) })
                .then(function(r) { return r.json(); }).then(function(d) {
                    if (d.status === 'ok') {
                        status.textContent = '已保存'; status.style.color = '#27ae60';
                        resetProviderForm();
                        loadConfig();
                    } else {
                        status.textContent = '失败：' + (d.message || '未知'); status.style.color = '#e74c3c';
                    }
                }).catch(function(e) { status.textContent = '请求失败：' + e.message; status.style.color = '#e74c3c'; });
        }

        function editProvider(id) {
            var p = configProviders.filter(function(x){ return x.id === id; })[0];
            if (!p) return;
            document.getElementById('config-edit-id').value = p.id;
            document.getElementById('config-name').value = p.name;
            document.getElementById('config-baseurl').value = p.base_url;
            document.getElementById('config-apikey').value = '';  // 不回显真实 key
            document.getElementById('config-apikey').placeholder = p.has_key ? 'API Key（留空则不修改已存的 key）' : 'API Key';
            document.getElementById('config-models').value = (p.models || []).join(',');
            document.getElementById('config-form-title').textContent = '编辑供应商 #' + p.id;
            document.getElementById('config-form-status').textContent = '';
        }

        function resetProviderForm() {
            document.getElementById('config-edit-id').value = '';
            document.getElementById('config-name').value = '';
            document.getElementById('config-baseurl').value = '';
            document.getElementById('config-apikey').value = '';
            document.getElementById('config-apikey').placeholder = 'API Key（编辑时留空则不修改）';
            document.getElementById('config-models').value = '';
            document.getElementById('config-form-title').textContent = '添加供应商';
            document.getElementById('config-form-status').textContent = '';
        }

        function deleteProvider(id) {
            if (!confirm('确定删除这个供应商？')) return;
            fetch(API + '/config/providers/' + id, { method: 'DELETE' })
                .then(function(r) { return r.json(); }).then(function() { loadConfig(); });
        }

        function escapeHtml(s) {
            return String(s == null ? '' : s).replace(/[&<>"']/g, function(c) {
                return { '&':'&amp;', '<':'&lt;', '>':'&gt;', '"':'&quot;', "'":'&#39;' }[c];
            });
        }

        // ============ Pipeline 相关函数 ============
        // Pipeline 缓存（减少频繁查询）
        var pipelineCache = null;
        var pipelineCacheTime = 0;
        var PIPELINE_CACHE_TTL = 30000; // 30 秒缓存

        function loadPipeline(forceRefresh) {
            var now = Date.now();

            // 如果缓存有效且不是强制刷新，直接使用缓存
            if (!forceRefresh && pipelineCache && (now - pipelineCacheTime < PIPELINE_CACHE_TTL)) {
                renderPipeline(pipelineCache);
                return;
            }

            fetch(API + '/pipeline/status').then(function(r) { return r.json(); }).then(function(d) {
                pipelineCache = d;
                pipelineCacheTime = now;
                renderPipeline(d);
            });
        }

        function renderPipeline(d) {
            // 更新详情文本
            document.getElementById('pipeline-l0-detail').textContent = d.l0.total + ' 条 (100%)';
            document.getElementById('pipeline-l1-detail').textContent = d.l1.extracted + '/' + d.l0.total + ' (' + d.l1.percent + '%)';
            document.getElementById('pipeline-embedding-detail').textContent = d.embedding.count + ' 条向量';
            document.getElementById('pipeline-narrative-detail').textContent = 'v' + d.narrative.version + (d.narrative.last_update ? ' · ' + formatTime(d.narrative.last_update) : '');

            // 绘制月相
            drawMoonPhase('moon-l0', d.l0.percent);
            drawMoonPhase('moon-l1', d.l1.percent);
            drawMoonPhase('moon-embedding', d.embedding.count > 0 ? 100 : 0);
            drawMoonPhase('moon-narrative', d.narrative.version > 0 ? 80 : 0);
        }

        function drawMoonPhase(canvasId, percent) {
            var canvas = document.getElementById(canvasId);
            if (!canvas) return;
            var ctx = canvas.getContext('2d');
            var centerX = 60, centerY = 60, radius = 55;

            // 清空画布
            ctx.clearRect(0, 0, 120, 120);

            // 背景（暗面）- 径向渐变增加立体感
            var darkGradient = ctx.createRadialGradient(centerX, centerY, 0, centerX, centerY, radius);
            darkGradient.addColorStop(0, '#2a2a2a');
            darkGradient.addColorStop(1, '#0a0a0a');
            ctx.fillStyle = darkGradient;
            ctx.beginPath();
            ctx.arc(centerX, centerY, radius, 0, Math.PI * 2);
            ctx.fill();

            // 根据进度计算月相
            // 0%=新月（全暗）, 50%=上弦月, 100%=满月（全亮）
            var phase = percent / 100;

            // 亮面 - 使用渐变模拟光照
            var lightGradient = ctx.createRadialGradient(centerX - 10, centerY - 10, 0, centerX, centerY, radius);
            lightGradient.addColorStop(0, '#faf8f0');
            lightGradient.addColorStop(0.6, '#e8e8d0');
            lightGradient.addColorStop(1, '#c8c8b0');
            ctx.fillStyle = lightGradient;
            ctx.beginPath();

            if (phase <= 0.5) {
                // 上弦月阶段 (0-50%)：右侧逐渐变亮
                var offset = (1 - phase * 2) * radius;
                ctx.arc(centerX, centerY, radius, -Math.PI/2, Math.PI/2);
                ctx.ellipse(centerX, centerY, offset, radius, 0, Math.PI/2, -Math.PI/2, true);
            } else {
                // 满月阶段 (50-100%)：左侧逐渐变亮
                var offset = ((phase - 0.5) * 2) * radius;
                ctx.arc(centerX, centerY, radius, Math.PI/2, -Math.PI/2);
                ctx.ellipse(centerX, centerY, offset, radius, 0, -Math.PI/2, Math.PI/2, true);
            }
            ctx.fill();

            // 月海效果（陨石坑纹理）- 只在亮面绘制
            ctx.save();
            ctx.clip(); // 限制在亮面区域
            ctx.globalAlpha = 0.15;

            // 绘制几个主要陨石坑
            var craters = [
                {x: 35, y: 40, r: 8},
                {x: 70, y: 50, r: 6},
                {x: 50, y: 70, r: 5},
                {x: 65, y: 35, r: 4},
                {x: 45, y: 55, r: 7}
            ];

            craters.forEach(function(crater) {
                var craterGradient = ctx.createRadialGradient(crater.x, crater.y, 0, crater.x, crater.y, crater.r);
                craterGradient.addColorStop(0, 'rgba(80, 80, 70, 0.8)');
                craterGradient.addColorStop(0.7, 'rgba(100, 100, 90, 0.3)');
                craterGradient.addColorStop(1, 'rgba(120, 120, 110, 0)');
                ctx.fillStyle = craterGradient;
                ctx.beginPath();
                ctx.arc(crater.x, crater.y, crater.r, 0, Math.PI * 2);
                ctx.fill();
            });

            ctx.restore();

            // 边缘光晕柔化
            ctx.globalCompositeOperation = 'source-over';
            var haloGradient = ctx.createRadialGradient(centerX, centerY, radius - 2, centerX, centerY, radius + 3);
            haloGradient.addColorStop(0, 'rgba(255, 255, 255, 0)');
            haloGradient.addColorStop(0.8, 'rgba(200, 200, 180, 0.1)');
            haloGradient.addColorStop(1, 'rgba(150, 150, 130, 0)');
            ctx.fillStyle = haloGradient;
            ctx.beginPath();
            ctx.arc(centerX, centerY, radius + 3, 0, Math.PI * 2);
            ctx.fill();

            // 显示百分比文字（在 canvas 下方）
            var container = canvas.parentElement;
            var percentText = container.querySelector('.moon-percentage');
            if (!percentText) {
                percentText = document.createElement('div');
                percentText.className = 'moon-percentage';
                container.appendChild(percentText);
            }
            percentText.textContent = Math.round(percent) + '%';
        }

        // ============ Extraction 相关函数 ============
        function loadExtraction() {
            fetch(API + '/l1/extraction_status').then(function(r) { return r.json(); }).then(function(d) {
                document.getElementById('extract-total').textContent = d.total_messages;
                document.getElementById('extract-done').textContent = d.extracted_messages;
                document.getElementById('extract-pending').textContent = d.pending_messages;

                var html = '';
                (d.batches || []).forEach(function(b) {
                    var statusClass = b.status === 'extracted' ? 'status-extracted' : (b.status === 'partial' ? 'status-partial' : 'status-pending');
                    var statusText = b.status === 'extracted' ? '已提取' : (b.status === 'partial' ? '部分完成' : '待提取');
                    html += '<tr>';
                    html += '<td>' + b.date + '</td>';
                    html += '<td>' + b.msg_range + '</td>';
                    html += '<td>' + b.total + '</td>';
                    html += '<td>' + (b.extracted || 0) + '</td>';
                    html += '<td><span class="status-badge ' + statusClass + '">' + statusText + '</span></td>';
                    html += '</tr>';
                });
                document.getElementById('extraction-batches').innerHTML = html || '<tr><td colspan="5" style="text-align:center;color:#888;">暂无数据</td></tr>';
            });
        }

        function triggerExtract() {
            var status = document.getElementById('extract-status');
            status.textContent = '启动中...';
            status.style.color = '#666';
            fetch(API + '/l1/extract_now', { method: 'POST' })
                .then(function(r) { return r.json(); })
                .then(function(d) {
                    if (d.status === 'ok') {
                        status.textContent = '提取任务已启动，请稍后刷新查看进度';
                        status.style.color = '#28a745';
                        setTimeout(loadExtraction, 3000);
                    } else {
                        status.textContent = '失败：' + (d.message || '未知');
                        status.style.color = '#dc3545';
                    }
                });
        }

        // ============ Narrative 相关函数 ============
        var currentNarrativeId = null;

        function loadNarrative() {
            fetch(API + '/narrative/current').then(function(r) { return r.json(); }).then(function(d) {
                if (d.exists) {
                    currentNarrativeId = d.id;
                    document.getElementById('narrative-meta').innerHTML =
                        '<strong>版本：</strong>v' + d.version + ' · ' +
                        '<strong>最后更新：</strong>' + formatTime(d.ts) + ' · ' +
                        '<strong>触发方式：</strong>' + (d.trigger_type === 'manual' ? '手动' : '自动');
                    document.getElementById('narrative-content').textContent = d.content;

                    // 填充 Observatory 数据
                    if (d.trigger_details) {
                        try {
                            var details = JSON.parse(d.trigger_details);
                            document.getElementById('observatory-reason').textContent = details.reason || '-';
                            document.getElementById('observatory-mode').textContent =
                                details.mode === 'full' ? '全量生成' :
                                details.mode === 'incremental' ? '增量演化' : '-';
                            document.getElementById('observatory-l1-count').textContent = details.l1_count || 0;
                            if (details.l1_ids && details.l1_ids.length > 0) {
                                document.getElementById('observatory-l1-ids').textContent = details.l1_ids.join(', ');
                            } else {
                                document.getElementById('observatory-l1-ids').textContent = '-';
                            }
                        } catch (e) {
                            console.error('Parse trigger_details failed:', e);
                        }
                    }
                } else {
                    currentNarrativeId = null;
                    document.getElementById('narrative-meta').textContent = '暂无叙事';
                    document.getElementById('narrative-content').textContent = '点击"生成/更新叙事"按钮开始创建共同经历叙事。';
                }
            });
        }

        function toggleNarrativeObservatory() {
            var elem = document.getElementById('narrative-observatory');
            elem.style.display = elem.style.display === 'none' ? 'block' : 'none';
        }

        var narrativeViewMode = 'read'; // 'read' | 'timeline'

        function showNarrativeTimeline() {
            narrativeViewMode = 'timeline';
            var content = document.getElementById('narrative-content').textContent;
            if (!content || content === '暂无内容' || content.indexOf('点击') === 0) {
                alert('请先生成叙事内容');
                return;
            }

            // 提取 ### 开头的章节作为时间节点
            var lines = content.split('\n');
            var nodes = [];
            var currentNode = null;

            lines.forEach(function(line) {
                if (line.startsWith('### ')) {
                    if (currentNode) nodes.push(currentNode);
                    currentNode = { title: line.replace('### ', ''), summary: [] };
                } else if (currentNode && line.trim()) {
                    if (currentNode.summary.length < 2) { // 只取每节前两行摘要
                        currentNode.summary.push(line.trim().substring(0, 80));
                    }
                }
            });
            if (currentNode) nodes.push(currentNode);

            if (nodes.length === 0) {
                alert('未找到时间节点（叙事格式需包含 ### 开头的章节标题）');
                return;
            }

            // 渲染时间线
            var html = '<div style="position:relative;padding-left:40px;">';
            html += '<div style="position:absolute;left:16px;top:0;bottom:0;width:2px;background:#e0e0e0;"></div>';
            nodes.forEach(function(node, i) {
                html += '<div style="position:relative;margin-bottom:24px;">';
                html += '<div style="position:absolute;left:-32px;top:4px;width:12px;height:12px;border-radius:50%;background:#6f42c1;border:2px solid #fff;box-shadow:0 0 0 2px #6f42c1;"></div>';
                html += '<div style="font-weight:bold;color:#333;margin-bottom:4px;">' + node.title + '</div>';
                node.summary.forEach(function(s) {
                    html += '<div style="font-size:12px;color:#666;">' + s + (s.length >= 80 ? '...' : '') + '</div>';
                });
                html += '</div>';
            });
            html += '</div>';
            html += '<div style="margin-top:16px;"><button class="btn" onclick="showNarrativeRead()" style="background:#999;">返回阅读</button></div>';

            document.getElementById('narrative-content').innerHTML = html;
        }

        function showNarrativeRead() {
            narrativeViewMode = 'read';
            loadNarrative(); // 重新加载原始文本
        }

        function generateNarrative() {
            var status = document.getElementById('narrative-status');
            status.textContent = '🔄 正在调用 LLM 生成叙事（预计 30-90 秒）...';
            status.style.color = '#666';
            status.style.fontWeight = 'bold';

            var startTime = Date.now();
            var timerInterval = setInterval(function() {
                var elapsed = Math.floor((Date.now() - startTime) / 1000);
                status.textContent = '🔄 生成中... ' + elapsed + 's（LLM 推理中，请稍候）';
            }, 1000);

            fetch(API + '/narrative/generate', {
                method: 'POST',
                headers: {'Content-Type': 'application/json'},
                body: JSON.stringify({trigger_type: 'manual', reason: 'Dashboard 手动触发'})
            })
            .then(function(r) { return r.json(); })
            .then(function(d) {
                clearInterval(timerInterval);
                var elapsed = Math.floor((Date.now() - startTime) / 1000);

                if (d.status === 'ok') {
                    status.textContent = '✅ 生成成功！（耗时 ' + elapsed + 's）';
                    status.style.color = '#28a745';
                    status.style.fontWeight = 'normal';
                    setTimeout(function() {
                        loadNarrative();
                        loadPipeline(true); // 强制刷新 Pipeline 缓存
                        status.textContent = '';
                    }, 2000);
                } else if (d.status === 'skipped') {
                    status.textContent = 'ℹ️ ' + (d.message || '没有新增重要记忆，无需更新');
                    status.style.color = '#666';
                    status.style.fontWeight = 'normal';
                } else {
                    status.textContent = '❌ 失败：' + (d.message || '未知');
                    status.style.color = '#dc3545';
                    status.style.fontWeight = 'normal';
                }
            })
            .catch(function(e) {
                clearInterval(timerInterval);
                status.textContent = '❌ 请求失败：' + e.message;
                status.style.color = '#dc3545';
                status.style.fontWeight = 'normal';
            });
        }

        function editNarrative() {
            if (!currentNarrativeId) {
                alert('暂无叙事内容可编辑');
                return;
            }
            var content = document.getElementById('narrative-content').textContent;
            document.getElementById('edit-narrative-content').value = content;
            document.getElementById('edit-narrative-status').textContent = '';
            document.getElementById('editNarrativeModal').classList.add('active');
            document.getElementById('edit-narrative-content').focus();
        }

        function closeEditNarrative() {
            document.getElementById('editNarrativeModal').classList.remove('active');
        }

        function saveEditNarrative() {
            var content = document.getElementById('edit-narrative-content').value.trim();
            var statusEl = document.getElementById('edit-narrative-status');
            if (!content) {
                statusEl.textContent = '内容不能为空';
                return;
            }
            statusEl.textContent = '保存中...';
            fetch(API + '/narrative/' + currentNarrativeId, {
                method: 'PUT',
                headers: {'Content-Type': 'application/json'},
                body: JSON.stringify({content: content})
            })
            .then(function(r) { return r.json(); })
            .then(function(d) {
                if (d.status === 'ok') {
                    statusEl.textContent = '已保存';
                    setTimeout(function() {
                        closeEditNarrative();
                        loadNarrative();
                    }, 800);
                } else {
                    statusEl.textContent = '保存失败：' + (d.message || '未知');
                }
            })
            .catch(function(e) {
                statusEl.textContent = '保存失败: ' + e.message;
            });
        }

        function loadNarrativeHistory() {
            fetch(API + '/narrative/history?limit=10')
                .then(function(r) { return r.json(); })
                .then(function(d) {
                    var html = '历史版本：\n\n';
                    (d.history || []).forEach(function(h) {
                        html += 'v' + h.version + ' - ' + formatTime(h.ts) + ' (' + h.status + ')\n';
                    });
                    alert(html || '暂无历史版本');
                });
        }

        // ============ Summary 相关函数 ============
        var currentSummaryId = null;

        function loadSummary() {
            // 加载当前摘要
            fetch(API + '/summary/current').then(function(r) { return r.json(); }).then(function(d) {
                if (d.exists) {
                    currentSummaryId = d.id;
                    var meta = '时间段：' + formatTime(d.period_start) + ' ~ ' + formatTime(d.period_end) + ' · 消息数：' + d.msg_count;
                    document.getElementById('summary-content').innerHTML = '<div style="font-size:11px;color:#888;margin-bottom:10px;">' + meta + '</div>' + escapeHtml(d.content).replace(/\n/g, '<br>');
                } else {
                    currentSummaryId = null;
                    document.getElementById('summary-content').textContent = '暂无摘要';
                }
            });

            // 加载配置
            fetch(API + '/summary/config').then(function(r) { return r.json(); }).then(function(d) {
                document.getElementById('summary-auto-enabled').value = d.auto_update_enabled;
                document.getElementById('summary-threshold-turns').value = d.check_threshold_turns;
                document.getElementById('summary-threshold-l1').value = d.check_threshold_l1;
                document.getElementById('summary-max-turns').value = d.summary_max_turns;
                document.getElementById('summary-max-tokens').value = d.summary_max_tokens;
            });

            // 加载 Observatory 数据
            loadSummaryObservatory();
        }

        function loadSummaryObservatory() {
            fetch(API + '/auto/status').then(function(r) { return r.json(); }).then(function(d) {
                var summaryData = d.summary || {};

                // 自动更新状态
                var autoEnabled = d.enabled === 1;
                document.getElementById('observatory-auto-status').textContent = autoEnabled ? '已启用' : '已禁用';
                document.getElementById('observatory-auto-status').style.color = autoEnabled ? '#28a745' : '#999';

                // 下次更新预计
                if (d.next_check) {
                    document.getElementById('observatory-next-update').textContent = '定时检查 ' + formatTime(d.next_check);
                } else {
                    document.getElementById('observatory-next-update').textContent = '-';
                }

                // 阈值进度
                var newMessages = summaryData.new_messages || 0;
                var threshold = summaryData.threshold || 50;
                var progress = Math.floor((newMessages / threshold) * 100);
                document.getElementById('observatory-threshold-progress').innerHTML =
                    newMessages + ' / ' + threshold + ' 轮对话 (' + progress + '%)';
            }).catch(function(e) {
                console.error('Load summary observatory failed:', e);
            });
        }

        function toggleSummaryObservatory() {
            var elem = document.getElementById('summary-observatory');
            elem.style.display = elem.style.display === 'none' ? 'block' : 'none';
            if (elem.style.display === 'block') {
                loadSummaryObservatory();
            }
        }

        function editSummary() {
            if (!currentSummaryId) {
                alert('暂无摘要内容可编辑');
                return;
            }
            fetch(API + '/summary/current').then(function(r) { return r.json(); }).then(function(d) {
                if (d.exists) {
                    document.getElementById('edit-summary-content').value = d.content;
                    document.getElementById('edit-summary-status').textContent = '';
                    document.getElementById('editSummaryModal').classList.add('active');
                    document.getElementById('edit-summary-content').focus();
                }
            });
        }

        function closeEditSummary() {
            document.getElementById('editSummaryModal').classList.remove('active');
        }

        function saveEditSummary() {
            var content = document.getElementById('edit-summary-content').value.trim();
            var statusEl = document.getElementById('edit-summary-status');
            if (!content) {
                statusEl.textContent = '内容不能为空';
                return;
            }
            statusEl.textContent = '保存中...';
            fetch(API + '/summary/' + currentSummaryId, {
                method: 'PUT',
                headers: {'Content-Type': 'application/json'},
                body: JSON.stringify({content: content})
            })
            .then(function(r) { return r.json(); })
            .then(function(d) {
                if (d.status === 'ok') {
                    statusEl.textContent = '已保存';
                    setTimeout(function() {
                        closeEditSummary();
                        loadSummary();
                    }, 800);
                } else {
                    statusEl.textContent = '保存失败：' + (d.message || '未知');
                }
            })
            .catch(function(e) {
                statusEl.textContent = '保存失败: ' + e.message;
            });
        }

        function generateSummary() {
            var status = document.getElementById('summary-status');
            status.textContent = '🔄 正在生成摘要...';
            status.style.color = '#666';
            status.style.fontWeight = 'bold';

            var startTime = Date.now();
            var timerInterval = setInterval(function() {
                var elapsed = Math.floor((Date.now() - startTime) / 1000);
                status.textContent = '🔄 生成中... ' + elapsed + 's';
            }, 1000);

            fetch(API + '/summary/generate', { method: 'POST' })
                .then(function(r) { return r.json(); })
                .then(function(d) {
                    clearInterval(timerInterval);
                    var elapsed = Math.floor((Date.now() - startTime) / 1000);

                    if (d.status === 'ok') {
                        status.textContent = '✅ 生成成功！（耗时 ' + elapsed + 's）';
                        status.style.color = '#28a745';
                        status.style.fontWeight = 'normal';
                        setTimeout(function() {
                            loadSummary();
                            status.textContent = '';
                        }, 2000);
                    } else {
                        status.textContent = '❌ 失败：' + (d.message || '未知');
                        status.style.color = '#dc3545';
                        status.style.fontWeight = 'normal';
                    }
                })
                .catch(function(e) {
                    clearInterval(timerInterval);
                    status.textContent = '❌ 请求失败：' + e.message;
                    status.style.color = '#dc3545';
                    status.style.fontWeight = 'normal';
                });
        }

        function saveSummaryConfig() {
            var status = document.getElementById('summary-config-status');
            status.textContent = '保存中...';

            var data = {
                auto_update_enabled: parseInt(document.getElementById('summary-auto-enabled').value),
                check_threshold_turns: parseInt(document.getElementById('summary-threshold-turns').value),
                check_threshold_l1: parseInt(document.getElementById('summary-threshold-l1').value),
                summary_max_turns: parseInt(document.getElementById('summary-max-turns').value),
                summary_max_tokens: parseInt(document.getElementById('summary-max-tokens').value)
            };

            fetch(API + '/summary/config', {
                method: 'PUT',
                headers: {'Content-Type': 'application/json'},
                body: JSON.stringify(data)
            })
            .then(function(r) { return r.json(); })
            .then(function(d) {
                if (d.status === 'ok') {
                    status.textContent = '保存成功';
                    status.style.color = '#28a745';
                } else {
                    status.textContent = '失败';
                    status.style.color = '#dc3545';
                }
            });
        }

        // ============ Config 扩展：模块配置 ============
        function loadConfig() {
            // 原有的供应商配置加载
            fetch(API + '/config/providers').then(function(r) { return r.json(); }).then(function(d) {
                configProviders = d.providers || [];
                configActive = d.active || null;

                // 原有逻辑保持不变...
                var activeText = '未配置';
                if (configActive && configActive.provider_id && configProviders.length > 0) {
                    var ap = configProviders.filter(function(p) { return p.id === configActive.provider_id; })[0];
                    if (ap) activeText = ap.name + ' / ' + configActive.model;
                }
                document.getElementById('config-active').textContent = '当前主聊天模型：' + activeText;

                var providerSelect = document.getElementById('config-active-provider');
                providerSelect.innerHTML = '<option value="">选择供应商</option>';
                configProviders.forEach(function(p) {
                    var opt = document.createElement('option');
                    opt.value = p.id;
                    opt.textContent = p.name;
                    if (configActive && p.id === configActive.provider_id) opt.selected = true;
                    providerSelect.appendChild(opt);
                });
                onActiveProviderChange();

                var listHtml = '';
                configProviders.forEach(function(p) {
                    listHtml += '<div style="padding:10px;background:#f9f9f9;border-radius:6px;margin-bottom:8px;">';
                    listHtml += '<strong>' + p.name + '</strong><br>';
                    listHtml += '<span style="font-size:11px;color:#666;">' + p.base_url + '</span><br>';
                    listHtml += '<span style="font-size:11px;color:#888;">模型：' + (p.models || []).join(', ') + '</span><br>';
                    listHtml += '<button class="btn btn-small" onclick="editProvider(' + p.id + ')">编辑</button> ';
                    listHtml += '<button class="btn btn-small btn-danger" onclick="deleteProvider(' + p.id + ')">删除</button>';
                    listHtml += '</div>';
                });
                document.getElementById('config-provider-list').innerHTML = listHtml || '<p style="color:#888;">暂无供应商</p>';
            });

            // 新增：加载模块配置
            loadModelConfigs();
        }

        function loadModelConfigs() {
            fetch(API + '/config/models').then(function(r) { return r.json(); }).then(function(d) {
                var configs = d.configs || {};
                var purposes = [
                    {key: 'chat', label: '主聊天模型'},
                    {key: 'l1_extract', label: 'L1 记忆提取'},
                    {key: 'embedding', label: '向量嵌入'},
                    {key: 'narrative', label: '共同经历叙事'},
                    {key: 'summary', label: '近期摘要'}
                ];

                var html = '';
                purposes.forEach(function(p) {
                    var cfg = configs[p.key];
                    html += '<div class="config-section">';
                    html += '<h4>' + p.label + '</h4>';
                    html += '<div class="config-field">';
                    html += '<label>供应商：</label>';
                    html += '<select id="model-' + p.key + '-provider" onchange="onModelProviderChange(\'' + p.key + '\')">';
                    html += '<option value="">未配置</option>';
                    configProviders.forEach(function(prov) {
                        var selected = cfg && cfg.provider_id === prov.id ? 'selected' : '';
                        html += '<option value="' + prov.id + '" ' + selected + '>' + prov.name + '</option>';
                    });
                    html += '</select>';
                    html += '</div>';
                    html += '<div class="config-field">';
                    html += '<label>模型：</label>';
                    html += '<select id="model-' + p.key + '-model" style="width:250px;"></select>';
                    html += '</div>';
                    html += '<button class="btn btn-small" onclick="saveModelConfig(\'' + p.key + '\')">保存</button>';
                    html += '<span id="model-' + p.key + '-status" style="margin-left:8px;font-size:11px;"></span>';
                    html += '</div>';
                });
                document.getElementById('model-configs').innerHTML = html;

                // 初始化模型下拉框
                purposes.forEach(function(p) {
                    onModelProviderChange(p.key);
                });
            });
        }

        function onModelProviderChange(purpose) {
            var providerSelect = document.getElementById('model-' + purpose + '-provider');
            var modelSelect = document.getElementById('model-' + purpose + '-model');
            var providerId = parseInt(providerSelect.value);

            modelSelect.innerHTML = '<option value="">选择模型</option>';

            if (!providerId) return;

            var provider = configProviders.filter(function(p) { return p.id === providerId; })[0];
            if (provider && provider.models) {
                provider.models.forEach(function(m) {
                    var opt = document.createElement('option');
                    opt.value = m;
                    opt.textContent = m;
                    modelSelect.appendChild(opt);
                });
            }
        }

        function saveModelConfig(purpose) {
            var providerId = parseInt(document.getElementById('model-' + purpose + '-provider').value);
            var model = document.getElementById('model-' + purpose + '-model').value;
            var status = document.getElementById('model-' + purpose + '-status');

            if (!providerId || !model) {
                status.textContent = '请选择供应商和模型';
                status.style.color = '#dc3545';
                return;
            }

            status.textContent = '保存中...';
            status.style.color = '#666';

            fetch(API + '/config/models/' + purpose, {
                method: 'PUT',
                headers: {'Content-Type': 'application/json'},
                body: JSON.stringify({provider_id: providerId, model_name: model})
            })
            .then(function(r) { return r.json(); })
            .then(function(d) {
                if (d.status === 'ok') {
                    status.textContent = '已保存';
                    status.style.color = '#28a745';
                } else {
                    status.textContent = '失败：' + (d.message || '未知');
                    status.style.color = '#dc3545';
                }
            });
        }

        // ============ System Logs 相关函数 ============
        function loadLogs() {
            var content = document.getElementById('logs-content');
            content.textContent = '加载中...';

            fetch(API + '/auto/logs?lines=200')
                .then(function(r) { return r.json(); })
                .then(function(d) {
                    if (d.logs && d.logs.length > 0) {
                        content.textContent = d.logs.join('\n');
                        // 自动滚动到底部
                        content.scrollTop = content.scrollHeight;
                    } else {
                        content.textContent = '暂无日志';
                    }
                })
                .catch(function(e) {
                    content.textContent = '加载失败: ' + e.message;
                });
        }

        function testAutoCheck() {
            var status = document.getElementById('logs-status');
            status.textContent = '触发检查中...';
            status.style.color = '#666';

            fetch(API + '/auto/check_now', { method: 'POST' })
                .then(function(r) { return r.json(); })
                .then(function(d) {
                    status.textContent = '✅ 检查完成，查看日志了解结果';
                    status.style.color = '#28a745';
                    setTimeout(function() {
                        loadLogs();
                        status.textContent = '';
                    }, 1500);
                })
                .catch(function(e) {
                    status.textContent = '❌ 请求失败: ' + e.message;
                    status.style.color = '#dc3545';
                });
        }

        // ============ Admin 危险操作 ============
        function confirmPurgeAll() {
            var confirmation = prompt(
                '⚠️ 警告：此操作将永久删除所有数据！\n\n' +
                '包括：\n' +
                '- L0 原文对话\n' +
                '- L1 提取记忆\n' +
                '- ChromaDB 向量库\n' +
                '- Shared Narrative 共同经历叙事\n' +
                '- Recent Summary 近期摘要\n' +
                '- User Profile 用户画像\n' +
                '- AI Profile AI画像\n\n' +
                '此操作不可逆！\n\n' +
                '如果确认清空，请输入：CONFIRM DELETE'
            );

            if (confirmation === 'CONFIRM DELETE') {
                executePurgeAll();
            } else if (confirmation !== null) {
                alert('确认文本不正确，操作已取消');
            }
        }

        function executePurgeAll() {
            var status = document.getElementById('purge-status');
            status.textContent = '🔄 正在清空所有数据...';
            status.style.color = '#dc3545';
            status.style.fontWeight = 'bold';

            fetch(API + '/admin/purge_all', {
                method: 'POST',
                headers: {'Content-Type': 'application/json'},
                body: JSON.stringify({confirmation: 'CONFIRM DELETE'})
            })
            .then(function(r) { return r.json(); })
            .then(function(d) {
                if (d.status === 'ok') {
                    status.textContent = '✅ 所有数据已清空！页面将在 3 秒后刷新...';
                    status.style.color = '#28a745';
                    setTimeout(function() {
                        location.reload();
                    }, 3000);
                } else {
                    status.textContent = '❌ 清空失败：' + (d.message || '未知错误');
                    status.style.color = '#dc3545';
                    status.style.fontWeight = 'normal';
                }
            })
            .catch(function(e) {
                status.textContent = '❌ 请求失败：' + e.message;
                status.style.color = '#dc3545';
                status.style.fontWeight = 'normal';
            });
        }

        loadStats();
        function loadConvs() {
            fetch(API + '/conversations').then(function(r) { return r.json(); }).then(function(d) {
                var sel = document.getElementById('convs-select');
                sel.innerHTML = '';
                (d.conversations || []).forEach(function(c) {
                    var o = document.createElement('option');
                    o.value = c.conv_id;
                    o.textContent = (c.conv_id.length > 40 ? c.conv_id.substring(0, 40) + '…' : c.conv_id) + '（' + c.msg_count + '条）';
                    sel.appendChild(o);
                });
                onConvSelect();
            }).catch(function(e) {
                document.getElementById('convs-status').textContent = '加载失败: ' + e;
            });
        }
        function onConvSelect() {
            var cid = document.getElementById('convs-select').value;
            if (!cid) return;
            fetch(API + '/conv/' + encodeURIComponent(cid) + '/settings').then(function(r) { return r.json(); }).then(function(d) {
                document.getElementById('convs-window-mode').value = d.window_mode || 'all';
                document.getElementById('convs-window-n').value = d.window_n || 50;
                document.getElementById('convs-window-tokens').value = d.window_tokens || 8000;
                document.getElementById('convs-effort').value = d.effort || 'medium';
                document.getElementById('convs-model').value = d.model || '';
                document.getElementById('convs-meta').textContent = '会话: ' + cid;
            });
        }
        function saveConvSettings() {
            var cid = document.getElementById('convs-select').value;
            if (!cid) return;
            var body = {
                window_mode: document.getElementById('convs-window-mode').value,
                window_n: parseInt(document.getElementById('convs-window-n').value) || 50,
                window_tokens: parseInt(document.getElementById('convs-window-tokens').value) || 8000,
                effort: document.getElementById('convs-effort').value,
                model: document.getElementById('convs-model').value.trim()
            };
            fetch(API + '/conv/' + encodeURIComponent(cid) + '/settings', {
                method: 'PUT',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify(body)
            }).then(function(r) { return r.json(); }).then(function(d) {
                var st = document.getElementById('convs-status');
                st.textContent = d.status === 'ok' ? '✓ 已保存' : '✗ 保存失败';
                setTimeout(function() { st.textContent = ''; }, 2500);
            }).catch(function(e) {
                document.getElementById('convs-status').textContent = '保存失败: ' + e;
            });
        }
    </script>
</body>
</html>
